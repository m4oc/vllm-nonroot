# ------------------------------------------------------------
# Create a non-root user for running vLLM securely
# ------------------------------------------------------------
# 06082026

FROM vllm/vllm-openai:latest

# UID 1000 has no /etc/passwd entry, so $HOME defaults to "/";
# pin it so vllm/uv write inside /home/vllm as intended.
ENV HOME=/home/vllm
ENV HF_HOME=/home/vllm/.cache/huggingface

# GID 0 is load-bearing: upstream only supports arbitrary UIDs
# that are members of group 0.
USER 1000:0

WORKDIR /home/vllm
EXPOSE 8000
